# TubeVault environment configuration
# Copy this file to `.env` and adjust values.

# --- Storage ---
# Where audio files land (default: ~/Music/TubeVault)
TUBEVAULT_AUDIO_PATH=

# Where video files land (default: ~/Videos/TubeVault)
TUBEVAULT_VIDEO_PATH=

# --- External tools ---
# Override auto-detection if these are not on $PATH
TUBEVAULT_YTDLP_PATH=
TUBEVAULT_FFMPEG_PATH=

# --- Database ---
# SQLite file path (default: ./data/tubevault.db)
TUBEVAULT_DB_PATH=

# --- Server ---
# Port for `npm run dev` (default: 3000, set by Next.js)
PORT=3000
